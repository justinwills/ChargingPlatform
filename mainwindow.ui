      <property name="styleSheet">
       <string notr="true">
QPushButton#BtnSetting {
    background-color: transparent;

    border: none;
    border-radius: 0px;

    color: #173A68;
    font-size: 17px;

    text-align: left;

    padding-left: 30px;
    padding-right: 10px;

    min-height: 52px;
}


/* 鼠标悬停 */
QPushButton#BtnSetting:hover {
    background-color: rgb(69, 104, 211);
}


/* 按下 */
QPushButton#BtnSetting:pressed, {
    background-color: #EBF1F8;
}
</string>
