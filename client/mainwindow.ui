    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
}
#BtnSettleOrder:hover { background: #ffc9c2; }

#BtnSetting {
    background: #ffffff;
    color: #131b2e;
    border: none;
    border-radius: 0px;
    font-size: 15px;
    font-weight: 500;
    text-align: left;
    padding-left: 20px;
}
#BtnSetting:hover { background: #f7f8ff; }
#BtnLeave {
    background: #ffffff;
    color: #ba1a1a;
    border: none;
    border-radius: 0px;
    font-size: 15px;
    font-weight: 500;
    text-align: left;
    padding-left: 20px;
}
#BtnLeave:hover { background: #fff4f2; }

#Btn_20, #Btn_50, #Btn_100, #Btn_200 {
    background: #f2f3ff;
    color: #131b2e;
    border: 1px solid #f2f3ff;
    border-radius: 16px;
    font-size: 18px;
    font-weight: 700;
}
#Btn_20:hover, #Btn_50:hover, #Btn_100:hover, #Btn_200:hover { border: 1px solid #2563eb; }

QFrame#loginCard, QFrame#homeBalanceCard, QFrame#balanceFrame, QFrame#profileCard,
QFrame#menuCard, QFrame#startStationCard, QFrame#guideCard, QFrame#monitorCard,
QFrame#sessionCard, QFrame#sdStatsCard, QDialog {
    background: #ffffff;
    border: 1px solid #eaedff;
    border-radius: 16px;
}
QFrame#walletCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #004ac6, stop:0.55 #2563eb, stop:1 #0053db);
    border: none;
    border-radius: 16px;
}
QLabel#labelTrust1, QLabel#labelTrust2, QLabel#labelTrust3, QLabel#labelTrust4 {
    background: #ffffff;
    border: 1px solid #eaedff;
    border-radius: 14px;
    color: #434655;
}
#pileScroll, QScrollArea#pileScroll &gt; QWidget &gt; QWidget { background: transparent; border: none; }
QFrame#pileCard {
    background: #ffffff;
    border: 1px solid #eaedff;
    border-radius: 14px;
}
QPushButton#pileStartBtn {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#pileStartBtn:hover { background: #004ac6; }
QScrollArea#nearbyListArea, QScrollArea#nearbyListArea > QWidget > QWidget { background: transparent; border: none; }
QFrame#stationCard {
    background: #ffffff;
    border: 1px solid #e8ecf5;
    border-radius: 16px;
}
QPushButton#stationDetailBtn {
    background: #2563eb;
    color: #ffffff;
    border: none;
