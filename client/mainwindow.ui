  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: "Inter","Microsoft YaHei";
    color: #434655;
    font-size: 13px;
    background: transparent;
}
QMainWindow, QWidget#centralwidget {
    background: #faf8ff;
}
QStackedWidget {
    background: #faf8ff;
}
#stackedWidget > QWidget {
    background: #faf8ff;
}
QScrollBar:vertical { background: transparent; width: 4px; }
QScrollBar::handle:vertical { background: #c3c6d7; border-radius: 2px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

#label_title_mine, #label_title_mine_2, #label_title_mine_3, #label_title_mine_4,
#label_title_mine_5, #label_title_mine_6 {
    color: #131b2e;
    font-size: 26px;
    font-weight: 700;
    background: transparent;
    border: none;
}
#labelHomeSub, #labelTagline, #labelNearbyCount, #labelNote {
    color: #737686;
    font-size: 12px;
    background: transparent;
}
#labelNearbyHeader {
    color: #131b2e;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}
#label_logo {
    background: #ffffff;
    border: 1px solid #eaedff;
    border-radius: 36px;
    color: #2563eb;
    font-size: 34px;
    font-weight: 700;
}
#labelOrderStatus { color: #00714d; font-size: 13px; background: transparent; }
#labelChevron1, #labelChevron2 { color: #c3c6d7; font-size: 20px; background: transparent; }

#label_phone, #labelOrderStationId, #labelPileId, #labelBalanceTitle, #labelHomeBalanceTitle,
#labelSDFreeTitle, #labelSDOnlineTitle, #labelSDPriceTitle, #labelTitleKwh, #labelTitleFee,
#labelTitleTime, #labelMonOrderId, #labelMonStart, #labelRechargeInterface,
#labelUserName_2, #labelStationId {
    color: #737686;
    font-size: 12px;
    background: transparent;
}

#labelMoney_c, #labelHomeBalance, #labelRechargeBalance, #labelMonKwh, #labelMonFee,
#labelElapsedTime {
    color: #131b2e;
    font-family: "Inter","Consolas","Microsoft YaHei";
    font-size: 21px;
    font-weight: 700;
    background: transparent;
}
#labelRechargeBalance { color: #ffffff; }
#labelSDFree, #labelSDOnline, #labelSDPrice {
    color: #131b2e;
    font-family: "Inter","Consolas","Microsoft YaHei";
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}
#labelMonStation { color: #131b2e; font-size: 19px; font-weight: 700; background: transparent; }
#labelMonStatus { color: #00714d; font-size: 13px; font-weight: 600; background: transparent; }
#labelMonSoc { color: #131b2e; font-size: 38px; font-weight: 800; background: transparent; }
#labelMonPower { color: #2563eb; font-size: 15px; font-weight: 700; background: transparent; }
#labelMonEta { color: #737686; font-size: 12px; background: transparent; }
#labelSDBadge, #labelTier {
    background: #dbe1ff;
    color: #003ea8;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
}
#labelMonBadge {
    background: #e0f7ec;
    color: #00714d;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
}
#labelWalletBadge1, #labelWalletBadge2 {
    background: rgba(255,255,255,38);
    color: #eeefff;
    border-radius: 10px;
    font-size: 10px;
    padding: 3px 8px;
}
#labelRechargeTitle { color: #dbe1ff; font-size: 12px; background: transparent; }
    #labelStats { color: #737686; font-size: 12px; background: transparent; }

QLineEdit {
    background: #f2f3ff;
    border: 1px solid #eaedff;
    border-radius: 14px;
    padding: 8px 14px;
    color: #131b2e;
    font-size: 15px;
    selection-background-color: #dbe1ff;
    selection-color: #003ea8;
    placeholder-text-color: #9aa0b5;
}
QLineEdit:focus { border: 1px solid #2563eb; background: #ffffff; }
#editPhone { padding-left: 46px; font-size: 16px; }

QSpinBox, QComboBox {
    background: #f2f3ff;
    border: 1px solid #eaedff;
    border-radius: 12px;
    padding: 6px 10px;
    color: #131b2e;
    font-size: 14px;
}
QComboBox:focus, QSpinBox:focus { border: 1px solid #2563eb; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #eaedff;
    border-radius: 12px;
    color: #131b2e;
    selection-background-color: #dbe1ff;
    selection-color: #003ea8;
}

QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #f2f3ff;
    border-radius: 14px;
    padding: 10px 12px;
    color: #434655;
    font-size: 12px;
}

#BtnRecharge, #BtnHomeRecharge {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
}
#BtnRecharge:hover, #BtnHomeRecharge:hover { background: #004ac6; }
#BtnRecharge:pressed, #BtnHomeRecharge:pressed { background: #003ea8; }
#BtnRecharge:disabled, #BtnHomeRecharge:disabled { background: #a5b7e8; color: #e8ecf7; }

#Btnlogin, #BtnConfirm_PageEdit, #BtnConfirm_pageRecharge, #BtnStartCharging,
#BtnSearchStations, #BtnStationDetail, #BtnStartChargeHere {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    padding: 10px 18px;
}
#Btnlogin:hover, #BtnConfirm_PageEdit:hover, #BtnConfirm_pageRecharge:hover,
#BtnStartCharging:hover, #BtnSearchStations:hover, #BtnStationDetail:hover,
#BtnStartChargeHere:hover { background: #004ac6; }
#Btnlogin:pressed, #BtnConfirm_PageEdit:pressed, #BtnConfirm_pageRecharge:pressed,
#BtnStartCharging:pressed, #BtnSearchStations:pressed, #BtnStationDetail:pressed,
#BtnStartChargeHere:pressed { background: #003ea8; }
#Btnlogin:disabled, #BtnConfirm_PageEdit:disabled, #BtnConfirm_pageRecharge:disabled,
#BtnStartCharging:disabled, #BtnSearchStations:disabled, #BtnStationDetail:disabled,
#BtnStartChargeHere:disabled { background: #a5b7e8; color: #e8ecf7; }

#BtnAdmin, #BtnCancel, #BtnCancel_pageRecharge, #BtnRefreshOrder, #BtnChoosePhoto,
#BtnStationBack, #BtnNavigateHere, #BtnLoadOrderStation {
    background: #e2e7ff;
    color: #131b2e;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
}
