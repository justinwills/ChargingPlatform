    font-weight: 600;
}
QPushButton#stationDetailBtn:hover { background: #004ac6; }
QPushButton#stationDetailBtn:pressed { background: #003ea8; }
QLabel#badgeStation {
    background: #fff1e6;
    color: #b45309;
    border-radius: 10px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#pillFree {
    background: #e2f6ec;
    color: #0d7a4e;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel#pillOnline {
