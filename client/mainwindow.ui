}
QLabel#pillPower {
    background: #e8f0ff;
    color: #1554d1;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#badgeCharging {
    background: #ffddb8;
    color: #653e00;
    border-radius: 9px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}
QLabel#badgeFault {
    background: #ffdad6;
    color: #93000a;
    border-radius: 9px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}

#widgetNavigation { background: rgba(255,255,255,248); border-top: 1px solid #eaedff; }
#BtnHome, #BtnCharge, #BtnMine {
    background: transparent;
    border: none;
    border-top: 3px solid transparent;
    color: #434655;
    font-size: 13px;
}
#BtnHome:checked, #BtnCharge:checked, #BtnMine:checked {
    color: #2563eb;
    font-weight: 700;
    border-top: 3px solid #2563eb;
}
#BtnHome:hover:!checked, #BtnCharge:hover:!checked,
#BtnMine:hover:!checked { color: #131b2e; }</string>
